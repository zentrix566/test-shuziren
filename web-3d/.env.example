# 豆包（火山引擎）TTS 配置
# 复制本文件为 .env，并填入你的真实值。.env 已被 .gitignore 忽略，不会提交。

# 专属 API Key（放在 X-Api-Key 请求头），必填
DOUBAO_API_KEY=your-api-key-here

# 资源 ID，豆包语音合成模型 2.0 固定为 seed-tts-2.0
DOUBAO_RESOURCE_ID=seed-tts-2.0

# 音色 speaker，按你账号可用的音色填写（朗读时的默认音色）
DOUBAO_SPEAKER=zh_female_gaolengyujie_uranus_bigtts

# 可选：自定义下拉里的音色列表，格式 "id|标签,id|标签"；留空则用内置列表。
# 注意：音色需先在火山控制台为你的账号开通，否则调用报 55000000（resource 与 speaker 不匹配）。
# DOUBAO_SPEAKERS=zh_female_vv_uranus_bigtts|女声·VV,zh_male_shaonianzixin_moon_bigtts|男声·少年自信

# 合成接口地址（一般不用改）
DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional

# 采样率
DOUBAO_SAMPLE_RATE=24000

# 中转后端监听端口（一般不用改）
PORT=8787
