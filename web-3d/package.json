{
  "name": "web-3d-digital-human",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server.mjs\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch-model": "node scripts/fetch-model.mjs",
    "fetch-anim": "node scripts/fetch-anim.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.4.0",
    "@pixiv/three-vrm-animation": "^3.5.4",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
